# Copy this file to .env and fill in your key. .env is git-ignored, so never commit your key.

# Google AI Studio API key with Veo access: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which video service to use: "veo", or "mock" (free test pattern, to try the pipeline)
VIDEO_PROVIDER=veo

# Veo model. "fast" is cheaper; use veo-3.1-generate-preview for the highest quality.
VEO_MODEL=veo-3.1-fast-generate-preview

# Model used by `npm run videos:character` to make the reference photo.
IMAGE_MODEL=gemini-3.1-flash-image

# Clip length in seconds (Veo 3.1 supports 4, 6 or 8).
VIDEO_DURATION_SEC=8

# Only used for the cost estimate printed before generating (USD per second of video).
VIDEO_PRICE_PER_SEC=0.15

# Reference photo of the character (keeps the same person in every clip).
CHARACTER_IMAGE=scripts/generate-videos/character.png

# How the character photo is used:
#   start-frame (default): the image model redraws her in each exercise's start position,
#                          and Veo animates from that frame (best form so far)
#   asset:                 photo sent as a reference image
#   first-frame:           clip starts from the plain standing photo
VEO_REFERENCE_MODE=start-frame
